# ==============================================================================
# ENTORNO DE DESARROLLO - PROYECTO GOWO
# ==============================================================================
# Renombra este archivo a ".env" antes de levantar el backend.
# Estas credenciales coinciden con la infraestructura Dockerizada en "gowo_infra"

# ------------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL
# ------------------------------------------------------------------------------
# URL de conexión con Prisma ORM mapeada al puerto 5433 (Evita colisiones locales)
DATABASE_URL="postgresql://gowo_admin:gowo_secure_pwd_2026@localhost:5433/gowo_db?schema=public"

# ------------------------------------------------------------------------------
# 2. Seguridad y Autenticación JWT
# ------------------------------------------------------------------------------
# Semillas para firmar tokens JWT (Asegúrate de cambiarlos en Productivo)
JWT_SECRET="gowo_super_secret_key_2026"
JWT_REFRESH_SECRET="gowo_super_refresh_secret_2026"

# ------------------------------------------------------------------------------
# 3. Configuración del Servidor Express
# ------------------------------------------------------------------------------
PORT=3000
